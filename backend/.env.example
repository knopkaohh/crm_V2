# Database
DATABASE_URL="postgresql://username:password@localhost:5432/birka_crm?schema=public"

# JWT Authentication
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# Server Configuration
PORT=3001
FRONTEND_URL="http://localhost:3000"

# Web Push (уведомления на телефон / PWA). Сгенерировать: npx tsx scripts/generate-vapid-keys.ts
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# Напоминание «Нужно позвонить клиенту» — каждый день в 9:00 (cron)
LEAD_CALL_REMINDER_CRON="0 9 * * *"
# Технолог для уведомления «Разработка макетов» (по умолчанию ищется Никита Царьков)
DESIGN_TECHNOLOGIST_EMAIL="hnikita@gmail.com"

# File Upload
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE="52428800"

# Google Sheets cold calls sync
GOOGLE_SHEETS_ID=""
GOOGLE_SHEETS_CONTACTS_TAB="Контакты"
GOOGLE_SERVICE_ACCOUNT_JSON=""
GOOGLE_SERVICE_ACCOUNT_FILE=""
COLD_CALLS_SYNC_CRON="*/2 * * * *"
# Optional: force imported records owner
COLD_CALLS_DEFAULT_USER_ID=""
